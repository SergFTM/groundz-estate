DATABASE_URL="file:./dev.db"
JWT_SECRET=""

# Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@groundz.estate
ADMIN_EMAIL=admin@groundz.estate

# === LOCAL AI (через llm-gateway, ai-net) ===
# Tenant-app зовёт ТОЛЬКО gateway. В dev можно указать прямой Ollama URL.
LOCAL_LLM_URL=http://llm-gateway:8080/v1
LOCAL_LLM_TIMEOUT_MS=60000

# Tier модели (gateway сам выберет — но клиент может явно попросить):
LLM_SMALL_MODEL=llama3.2:3b
LLM_LARGE_MODEL=qwen2.5:14b
LLM_DEFAULT_TIER=large

# Embeddings
EMBED_MODEL=nomic-embed-text

# Image generation (через gateway → Auto1111)
LOCAL_IMAGE_URL=http://llm-gateway:8080/sd
LOCAL_IMAGE_MODEL=sdxl
LOCAL_IMAGE_STEPS=28
LOCAL_IMAGE_CFG=7

# Tenant routing
TENANT_SLUG=groundz

# AI cache & limits
SEO_AI_DAILY_BUDGET_USD=0
SEO_AI_PER_USER_DAILY_USD=0
SEO_CACHE_TTL_SECONDS=86400
