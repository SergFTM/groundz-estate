generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  role      String     // buyer | investor | agent | internal_team
  name      String?
  phone     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  leads              Lead[]               @relation("LeadUser")
  agentLeads         Lead[]               @relation("LeadAgent")
  documents          Document[]
  payments           Payment[]
  units              Unit[]               @relation("UnitBuyer")
  investments        InvestorInvestment[]
  commissions        Commission[]
  articleComments    ArticleComment[]
  articleCommentLikes ArticleCommentLike[]
  otcListings  OtcListing[] @relation("OtcSeller")
  otcOffers    OtcOffer[]   @relation("OtcBuyer")
}

model Project {
  id                String              @id @default(uuid())
  name              String
  slug              String              @unique
  location          String
  description       String?
  imageUrl          String?
  status            String              // active | coming_soon | completed
  createdAt         DateTime            @default(now())

  units             Unit[]
  constructionPhases ConstructionPhase[]
}

model Unit {
  id        String    @id @default(uuid())
  projectId String
  code      String
  type      String    // studio | 1bed | 2bed | 3bed | penthouse
  bedrooms  Int
  floor     Int
  areaSqm   Float
  price     Float?
  status      String    @default("available") // available | reserved | sold
  tourImages   String?   // JSON: [{url, label, roomIndex, angle: 'left'|'front'|'right'}]
  tourFloorPlan String?  // AI-generated 3D isometric floor plan: /images/tours/<code>/floor-plan.jpg
  floorPlanUrl String?   // uploaded plan: /uploads/floor-plans/<unitId>-<file>
  buyerId      String?

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buyer     User?     @relation("UnitBuyer", fields: [buyerId], references: [id])
  payments  Payment[]
  otcListings  OtcListing[] @relation("UnitOtcListings")
}

model ConstructionPhase {
  id          String             @id @default(uuid())
  projectId   String
  name        String
  description String?
  status      String             // completed | in_progress | pending
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media       ConstructionMedia[]
}

model ConstructionMedia {
  id       String            @id @default(uuid())
  phaseId  String
  url      String
  type     String            // image | video
  caption  String?

  phase    ConstructionPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String    @id @default(uuid())
  userId      String
  unitId      String
  description String
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  status      String    // paid | upcoming | overdue
  invoiceUrl  String?

  user        User      @relation(fields: [userId], references: [id])
  unit        Unit      @relation(fields: [unitId], references: [id])
}

model Document {
  id         String   @id @default(uuid())
  userId     String
  poolId     String?  // optional link to an investment pool
  name       String
  category   String   // contract | passport | tax | proof_of_funds | kyc | floor_plan | subscription_agreement | other
  fileUrl    String
  fileSize   Int
  status     String   @default("pending") // approved | pending | action_required
  uploadedAt DateTime @default(now())

  user       User            @relation(fields: [userId], references: [id])
  pool       InvestmentPool? @relation(fields: [poolId], references: [id], onDelete: SetNull)
}

model Commission {
  id          String   @id @default(uuid())
  agentId     String
  description String
  amount      Float
  status      String   @default("pending") // pending | approved | paid
  createdAt   DateTime @default(now())

  agent User @relation(fields: [agentId], references: [id])
}

model Lead {
  id        String   @id @default(uuid())
  userId    String?
  agentId   String?
  source    String   // quiz | newsletter | brochure | call_booking
  status    String   @default("new") // new | contacted | converted | lost
  name      String?
  email     String?
  phone     String?
  data      String?  // JSON string
  tag       String?  // hot | warm | cold
  createdAt DateTime @default(now())

  user      User?    @relation("LeadUser", fields: [userId], references: [id])
  agent     User?    @relation("LeadAgent", fields: [agentId], references: [id])
}

model InvestmentPool {
  id                   String   @id @default(uuid())
  slug                 String?  @unique
  name                 String
  projectName          String
  country              String   @default("Cyprus")
  city                 String?
  dealType             String?  // equity | debt_note | rental | club_deal
  goalAmount           Float
  raisedAmount         Float    @default(0)
  targetYield          Float
  targetIrr            Float?
  preferredReturn      Float?
  hurdleRate           Float?
  termMonths           Int
  minTicket            Float
  maxTicket            Float?
  exitType             String?  // sale | refinance | hybrid
  capitalType          String?  // equity | mezzanine | senior_debt
  spvName              String?
  ltv                  Float?
  ltc                  Float?
  developerCoinvestPct Float?
  raiseEnd             DateTime?
  status               String   @default("active") // active | closed | completed
  imageUrl             String?
  description          String?
  locationThesis       String?
  demandThesis         String?
  constructionThesis   String?
  exitThesis           String?
  summary              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  investments         InvestorInvestment[]
  milestones          Milestone[]
  constructionReports ConstructionReport[]
  documents           Document[]
}

model InvestorInvestment {
  id        String   @id @default(uuid())
  userId    String
  poolId    String
  amount    Float
  status    String   @default("soft_commit") // soft_commit | pending | funded | cancelled
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user      User           @relation(fields: [userId], references: [id])
  pool      InvestmentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  otcListings  OtcListing[] @relation("InvestmentOtcListings")
}

model Milestone {
  id            String         @id @default(uuid())
  poolId        String
  name          String
  description   String?
  plannedDate   DateTime
  actualDate    DateTime?
  completionPct Int            @default(0)
  status        String         @default("pending") // pending | in_progress | completed | delayed
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  pool InvestmentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
}

model ConstructionReport {
  id             String         @id @default(uuid())
  poolId         String
  reportDate     DateTime
  overallPct     Int
  budgetTotal    Float
  budgetSpent    Float
  budgetVariance Float
  notes          String?
  aiAnalysis     String?
  createdAt      DateTime       @default(now())

  pool InvestmentPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
}

model AiResponseCache {
  id         String   @id @default(uuid())
  cacheKey   String   @unique
  response   String
  model      String
  tokensUsed Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model JobPosition {
  id          String   @id @default(uuid())
  title       String
  department  String
  location    String
  type        String   // full_time | part_time | contract
  description String
  isActive    Boolean  @default(true)
  slug        String   @unique
  createdAt   DateTime @default(now())

  applications JobApplication[]
}

model JobApplication {
  id          String      @id @default(uuid())
  positionId  String
  name        String
  email       String
  linkedinUrl String?
  resumeUrl   String?
  coverLetter String?
  createdAt   DateTime    @default(now())

  position    JobPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Article {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String
  excerpt     String?
  content     String
  imageUrl    String?
  publishedAt DateTime @default(now())

  comments    ArticleComment[]
}

model ArticleComment {
  id        String   @id @default(uuid())
  articleId String
  userId    String
  content   String
  parentId  String?
  createdAt DateTime @default(now())

  article  Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   ArticleComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  ArticleComment[] @relation("CommentReplies")
  likes    ArticleCommentLike[]
}

model ArticleCommentLike {
  commentId String
  userId    String

  comment ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String @id @default(uuid())
  question  String
  answer    String
  sortOrder Int
  category  String  @default("General")
}

// === MODULE: SEO ===

model SeoKeywordCluster {
  id           String   @id @default(uuid())
  name         String
  locale       String   // en | ru
  intent       String   // informational | commercial | transactional
  primaryTerm  String
  termsJson    String   // JSON: string[]
  entitiesJson String?  // JSON: string[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pageProfiles SeoPageProfile[]
}

model SeoPageProfile {
  id               String    @id @default(uuid())
  route            String?   @unique  // null if tied to articleId
  articleId        String?   @unique  // null if tied to route
  locale           String    // en | ru
  pageType         String    // landing | article | faq | project
  primaryClusterId String?
  targetKeywords   String?   // JSON: string[]
  metaTitle        String?
  metaDescription  String?
  seoScore         Float?
  lastAuditAt      DateTime?
  lastAiRunAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  primaryCluster      SeoKeywordCluster?      @relation(fields: [primaryClusterId], references: [id])
  audits              SeoAudit[]
  revisions           SeoContentRevision[]
  linkSuggestionsFrom InternalLinkSuggestion[] @relation("FromPage")
  linkSuggestionsTo   InternalLinkSuggestion[] @relation("ToPage")
}

model SeoAudit {
  id               String   @id @default(uuid())
  seoPageProfileId String
  score            Float
  issuesJson       String   // JSON: SeoIssue[]
  suggestionsJson  String   // JSON: SeoSuggestion[]
  aiSummary        String?
  aiAvailable      Boolean  @default(true)
  createdAt        DateTime @default(now())

  pageProfile SeoPageProfile @relation(fields: [seoPageProfileId], references: [id], onDelete: Cascade)
}

// SQLite adaptation: FK targets must be non-nullable @unique or @id.
// SeoPageProfile.route is nullable so we use ID-based relations here.
model InternalLinkSuggestion {
  id            String   @id @default(uuid())
  fromProfileId String
  toProfileId   String
  fromRoute     String   // denormalized for display
  toRoute       String   // denormalized for display
  anchorText    String
  confidence    Float
  status        String   // suggested | approved | applied | rejected
  createdAt     DateTime @default(now())

  fromPage SeoPageProfile @relation("FromPage", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toPage   SeoPageProfile @relation("ToPage",   fields: [toProfileId],   references: [id], onDelete: Cascade)
}

model SeoContentRevision {
  id               String   @id @default(uuid())
  seoPageProfileId String
  originalText     String
  proposedText     String
  diffJson         String?  // JSON: diff[]
  changeType       String   // title | meta | heading | body | faq
  status           String   // pending | approved | rejected | applied
  createdAt        DateTime @default(now())

  pageProfile SeoPageProfile @relation(fields: [seoPageProfileId], references: [id], onDelete: Cascade)
}

model MarketIndex {
  id         String    @id @default(uuid())
  symbol     String    @unique
  name       String
  type       String    // "etf" | "custom"
  market     String    // "global" | "europe" | "cyprus" | "georgia" | "dubai" | "turkey"
  color      String    @default("#7a8c6e")
  active     Boolean   @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())

  components IndexComponent[]
  prices     DailyPrice[]
}

model IndexComponent {
  id      String @id @default(uuid())
  indexId String
  symbol  String
  name    String
  weight  Float  // 0.0 – 1.0, sum per index must equal 1.0

  index MarketIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([indexId, symbol])
}

model DailyPrice {
  id        String   @id @default(uuid())
  indexId   String
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float?
  changePct Float?

  index MarketIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([indexId, date])
}

// === MODULE: OTC SECONDARY MARKET ===

model OtcListing {
  id           String    @id @default(uuid())
  sellerId     String
  assetType    String    // investment_share | option_contract | apartment
  investmentId String?   // → InvestorInvestment.id
  unitId       String?   // → Unit.id
  title        String
  description  String?
  askPrice     Float
  currency     String    @default("EUR")
  status       String    @default("pending")
  // pending | active | sold | cancelled | rejected
  adminNote    String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  seller     User                @relation("OtcSeller", fields: [sellerId], references: [id])
  investment InvestorInvestment? @relation("InvestmentOtcListings", fields: [investmentId], references: [id], onDelete: SetNull)
  unit       Unit?               @relation("UnitOtcListings", fields: [unitId], references: [id], onDelete: SetNull)
  offers     OtcOffer[]
}

model OtcOffer {
  id        String     @id @default(uuid())
  listingId String
  buyerId   String
  amount    Float
  message   String?
  status    String     @default("pending")
  // pending | accepted | declined
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  listing OtcListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User       @relation("OtcBuyer", fields: [buyerId], references: [id])
}
